# Web (Vercel): configúralas en Vercel → Settings → Environment Variables. Nunca pongas valores reales aquí.
APIFY_TOKEN=
# Cloudflare Turnstile (anti-bots). Sin ellas, la conversión desde YouTube queda desactivada.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Máximo global de descargas de YouTube en 24 h (protege el crédito de Apify). Por defecto 30.
YOUTUBE_DAILY_LIMIT=30

# App de escritorio / servidor Express local
PORT=3000
